{{!-- Rendered by CPRActiveEffectSheet (ApplicationV2). The application root element is the <form>. --}}
<div class="active-effects-sheet">
  <!-- Effect Header -->
  <header class="sheet-header">
    <img class="effect-icon" src="{{effect.img}}" data-action="cprEditImage" data-edit="img" data-tooltip="{{localize "CPR.effectSheet.image"}}"/>
    <h1 class="effect-title">{{effect.name}}</h1>
  </header>
  <!-- Effect Configuration Tabs -->
  <nav class="sheet-tabs tabs">
    <a class="item {{#if (cprCompare activeTab "===" "details")}}active{{/if}}" data-cpr-tab="details"><i class="fas fa-book"></i> {{localize "CPR.effectSheet.tabDetails"}}</a>
    <a class="item {{#if (cprCompare activeTab "===" "effects")}}active{{/if}}" data-cpr-tab="effects"><i class="fas fa-gears"></i> {{localize "CPR.effectSheet.tabEffects"}}</a>
  </nav>
  <!-- Details Tab -->
  <section class="tab {{#if (cprCompare activeTab "===" "details")}}active{{/if}}" data-cpr-tab="details">
    <div class="form-group">
      <label>{{localize "CPR.effectSheet.name"}}</label>
      <div class="form-fields">
        <input type="text" name="name" value="{{effect.name}}"/>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "CPR.effectSheet.image"}}</label>
      <div class="form-fields">
        <file-picker type="image" name="img" value="{{effect.img}}"></file-picker>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "CPR.effectSheet.tint"}}</label>
      <div class="form-fields">
        <color-picker name="tint" value="{{effect.tint}}"></color-picker>
      </div>
    </div>
  </section>
  <!-- Effects Tab -->
  <section class="tab {{#if (cprCompare activeTab "===" "effects")}}active{{/if}}" data-cpr-tab="effects">
    <ol class="changes-list">
      <header class="change-header flexrow">
        <div class="change-key">{{localize "CPR.effectSheet.changeKey"}}</div>
        <div class="change-value">{{localize "CPR.effectSheet.changeValue"}}</div>
        <div class="change-mode">{{localize "CPR.effectSheet.changeMode"}}</div>
        <div class="situational">
          {{localize "CPR.effectSheet.header.situational"}}
        </div>
        <div class="on-by-default">
          {{localize "CPR.effectSheet.header.onByDefault"}}
        </div>
        <div class="change-actions">
          {{localize "CPR.effectSheet.actions"}}
        </div>
      </header>
      {{#each modList as |change i|}}
        <li class="flexrow" data-index="{{i}}">
          <div class="change-key" data-index="{{i}}">
            <span class="form-fields effect-key-category" data-index="{{i}}">
              <select class="key-cat" name="flags.cyberpunk-red-core-dmbank.changes.cats.{{i}}">
                {{selectOptions (cprFindConfigObj "activeEffectCategories") selected=change.category localize=true}}
              </select>
            </span>
            {{!-- The next line is responsible for displaying the input for the 'key' field. --}}
            {{change.keyInput}}
          </div>
          <div class="change-value">
            <input type="text" name="{{../changesPath}}.{{i}}.value" value="{{change.rawValue}}"/>
          </div>
          <div class="change-mode">
            {{!-- Using other modes for skills means we need to make changes to actor.bonuses. Rather than 0 all values out, it
            needs to persist the existing value, and the mode so the math applies correctly. This has implications
            on how to present in the actor sheet too. --}}
            {{change.modeInput}}
            {{#unless (cprCompare change.category "===" "stat")}}
              <span>
                {{localize "CPR.effectSheet.modifiers.addSubtract"}}
                <i class="fas fa-circle-question" data-tooltip="{{localize "CPR.effectSheet.info.deleteAndModesComing"}}"></i>
              </span>
            {{/unless}}
          </div>
          <div class="situational">
            <input name="flags.cyberpunk-red-core-dmbank.changes.situational.{{i}}.isSituational" type="checkbox" data-index="{{i}}" {{checked change.isSituational}} {{disabled (cprCompare change.category "===" "stat")}}/>
          </div>
          <div class="on-by-default">
            <input name="flags.cyberpunk-red-core-dmbank.changes.situational.{{i}}.onByDefault" type="checkbox" data-index="{{i}}" {{checked change.onByDefault}} {{#unless change.isSituational}}disabled{{/unless}} {{disabled (cprCompare change.category "===" "stat")}}/>
          </div>
          <div class="change-actions">
            <a class="effect-change-control" data-action="cprDeleteChange" data-index="{{i}}"><i class="fas fa-trash-can"></i></a>
          </div>
        </li>
      {{/each}}
    </ol>
    <br/>
    <div class="item-controls effect-controls">
      <a class="effect-change-control"
         data-action="cprAddChange"
         data-tooltip="{{localize "CPR.effectSheet.createModDesc"}}">
        <i class="far fa-square-plus"></i> {{localize "CPR.effectSheet.createMod"}}
      </a>
    </div>
    <br/>
  </section>
  <footer class="sheet-footer">
    <button type="button" data-action="cprSaveAndClose">
      <i class="fas fa-floppy-disk"></i> {{localize "CPR.effectSheet.saveAndClose"}}
    </button>
  </footer>
</div>
